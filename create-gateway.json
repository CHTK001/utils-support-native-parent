{
  "Image": "gateway-server:latest",
  "Cmd": ["/opt/java/openjdk/bin/java", "-cp", "/app/gateway-server.jar:/app/dependencies/*", "com.chua.gateway.server.GatewayServerApplication"],
  "Env": [
    "JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75 -Dfile.encoding=UTF-8",
    "GATEWAY_GUACD_HOST=guacd",
    "GATEWAY_GUACD_PORT=4822"
  ],
  "ExposedPorts": { "8090/tcp": {}, "8182/tcp": {}, "4822/tcp": {} },
  "HostConfig": {
    "PortBindings": {
      "8090/tcp": [{ "HostPort": "18090" }],
      "8182/tcp": [{ "HostPort": "18182" }],
      "4822/tcp": [{ "HostPort": "14822" }]
    },
    "RestartPolicy": { "Name": "always" }
  },
  "Name": "gateway-server"
}
