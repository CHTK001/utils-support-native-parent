# ============================================================================
# CUDA 运行时库配置（.env 格式）
# 所有脚本与本模块 Java 代码均从此文件读取，禁止硬编码路径/版本/URL
# ============================================================================

# 目标 CUDA 主版本（onnxruntime-gpu 1.21+ 需要 CUDA 12 + cuDNN 9）
CUDA_MAJOR=12

# 配套 onnxruntime-gpu 版本（用于校验匹配，信息性）
ORT_VERSION=1.27.0

# CUDA 运行库目标目录（相对本模块根目录；脚本与 Java 异步下载均写入此处）
TARGET_DIR=libs/cuda

# pip 运行时包名（Windows/Linux 通过 pip 从 nvidia-*-cu12 获取 DLL/.so）
PIP_RUNTIME=nvidia-cuda-runtime-cu12
PIP_CUBLAS=nvidia-cublas-cu12
PIP_CUDNN=nvidia-cudnn-cu12

# 直接下载兜底 URL（pip 不可用时用 curl/Invoke-WebRequest 拉取）
# Windows 示例（官方 CUDA 12 运行库 zip 解包后拷贝）
CUDART_URL=https://developer.download.nvidia.com/compute/cuda/12.6.0/local_installers/cuda_12.6.0_windows_network.exe
CUBLAS_URL=https://developer.download.nvidia.com/compute/cuda/12.6.0/local_installers/cuda_12.6.0_windows_network.exe

# 下载超时（秒）
DOWNLOAD_TIMEOUT_SEC=600

# 是否在下载完成后自动加入 PATH（Windows 注册表 / Linux ldconfig / macOS 提示）
AUTO_PATH=true
